      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpsDesk.Application\OpsDesk.Application.csproj" />
    <ProjectReference Include="..\OpsDesk.Infrastructure\OpsDesk.Infrastructure.csproj" />
  </ItemGroup>

</Project>
